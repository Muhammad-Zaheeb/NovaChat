DATABASE_URL=postgresql+asyncpg://USER@localhost:5432/novachat
SECRET_KEY=change-me   # generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]

# Email: "console" prints codes to the server log (dev). "smtp" sends real mail (Gmail: see README).
EMAIL_BACKEND=console
EMAIL_FROM=NovaChat <your.address@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# File uploads. "local" stores under backend/uploads (dev). "s3" works with any S3-compatible
# service, e.g. Cloudflare R2: endpoint https://<account>.r2.cloudflarestorage.com, region auto.
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Optional: public bucket/CDN base URL, used for profile pictures only (chat media is always served via the authenticated API)
S3_PUBLIC_BASE_URL=
UPLOADS_PER_MINUTE=30
