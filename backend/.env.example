# development | production. Production enforces a strong SECRET_KEY, COOKIE_SECURE=true and S3 storage.
ENV=development
# Local: postgresql+asyncpg://USER@localhost:5432/novachat
# Neon:  paste the connection string as-is (postgresql://...?sslmode=require); it is converted automatically.
#        Use the DIRECT (non "-pooler") host so migrations work.
DATABASE_URL=postgresql+asyncpg://USER@localhost:5432/novachat
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300
SECRET_KEY=change-me   # generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
# Production: your real origin only, e.g. ["https://novachat.onrender.com"]
CORS_ORIGINS=["http://localhost:5173"]
# Behind Render's proxy set true so the real client IP (X-Forwarded-For) is used for rate limits.
TRUST_PROXY=false
TRUSTED_PROXY_HOPS=1
# Built frontend served at / (default ../frontend/dist, relative to backend/)
FRONTEND_DIST=../frontend/dist

# Email: "console" prints codes to the log (dev). "smtp" = Gmail etc. "brevo" = Brevo HTTP API
# (use it if the host blocks outbound SMTP ports).
EMAIL_BACKEND=console
EMAIL_FROM=NovaChat <your.address@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
BREVO_API_KEY=

# File uploads. "local" stores under backend/uploads (dev only). "s3" works with any S3-compatible
# service, e.g. Supabase Storage: endpoint https://<project-ref>.supabase.co/storage/v1/s3, region = project region
# (private bucket + S3 access keys), or Cloudflare R2: https://<account>.r2.cloudflarestorage.com, region auto.
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Optional: public bucket/CDN base URL, used for profile pictures only (chat media is always served via the authenticated API)
S3_PUBLIC_BASE_URL=
UPLOADS_PER_MINUTE=30

# Error tracking (optional). Empty = off. No PII is sent; cookies/auth headers are scrubbed.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
